---
interface Card {
  name?: string;
  monster?: string;
  effect?: string;
  image?: string;
  alt?: string;
}

interface Props {
  card: Card;
  eager?: boolean;
}

const { card, eager = false } = Astro.props;

// All card art is 447x595. Update here if the art size changes.
const IMAGE_WIDTH = 447;
const IMAGE_HEIGHT = 595;

// A value is a placeholder if it is missing, empty, or starts with "TODO"
const isTodo = (value?: string) => !value?.trim() || value.trim().startsWith('TODO');
const show = (value: string | undefined, field: string) =>
  value?.trim() ? value : `TODO: ${field}`;
---

<article class="card-tile">
  {
    isTodo(card.image) ? (
      <div class="card-tile__art">
        <div class="card-tile__placeholder" role="img" aria-label="TODO: card art">
          <span class="todo">{show(card.image, 'card art')}</span>
        </div>
      </div>
    ) : (
      <img
        class="card-tile__art"
        src={card.image}
        alt={card.alt ?? ''}
        width={IMAGE_WIDTH}
        height={IMAGE_HEIGHT}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )
  }
  <div class="card-tile__body">
    <h3 class:list={['card-tile__name', { todo: isTodo(card.name) }]}>{show(card.name, 'name')}</h3>
    <p class:list={['card-tile__monster', { todo: isTodo(card.monster) }]}>
      {show(card.monster, 'monster type')}
    </p>
    <p class:list={['card-tile__effect', { todo: isTodo(card.effect) }]}>
      {show(card.effect, 'effect')}
    </p>
  </div>
</article>

<style>
  .card-tile {
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border: 2px solid var(--color-purple);
    border-radius: var(--radius);
  }

  .card-tile__art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 447 / 595;
    background: var(--color-bg);
  }

  .card-tile__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-4);
    border-bottom: 2px dashed var(--color-purple);
    color: var(--color-text-muted);
    text-align: center;
  }

  .card-tile__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .card-tile__name {
    margin-bottom: var(--space-2);
  }

  .card-tile__monster {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: 0 var(--space-3);
    border: 2px solid var(--color-green);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .card-tile__effect {
    margin-bottom: 0;
    /* Effect text uses line breaks; show them as written */
    white-space: pre-line;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card-tile {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .card-tile:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 28px rgb(106 27 154 / 0.55);
    }
  }
</style>
