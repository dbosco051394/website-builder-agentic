---
import Layout from '../layouts/Layout.astro';
import ArtPlaceholder from '../components/ArtPlaceholder.astro';
import cards from '../data/cards.json';

// Cards featured in the "Cute until it isn't." band
const sillyCard = cards.find((card) => card.id === 'skeleton-01'); // Numbskull
const scaryCard = cards.find((card) => card.id === 'werewolf-01'); // Starving Beast
---

<Layout
  title="Monster Book | Eat their hearts out!"
  description="Monster Book is the fast, funny, spooky card game where the victory points are real candy, and you can eat your opponents' points."
>
  <section class="hero">
    <div class="container">
      <h1>Eat their hearts out!</h1>
      <p class="hero__subhead">
        Monster Book is the fast, funny, spooky card game where the victory
        points are real candy, and you can eat your opponents' points.
      </p>
      <ul class="badges" aria-label="Game facts">
        <li>2-4 players</li>
        <li>Ages 10+</li>
        <li><span class="todo">TODO: 45-90 mins</span></li>
      </ul>
      <div class="hero__actions">
        <!-- TODO: Kickstarter URL -->
        <a class="button button--primary" href="#">Support us on Kickstarter!</a>
        <a class="button button--secondary" href="#how-it-works">See how it works</a>
      </div>
      <div class="hero__art">
        <ArtPlaceholder label="TODO: hero art" />
      </div>
    </div>
  </section>

  <section class="section section--alt" id="how-it-works">
    <div class="container">
      <h2>How it works in 3 steps</h2>
      <ol class="steps">
        <li class="step">
          <h3><span class="step__num">1.</span> Wake your monsters</h3>
          <p>
            Ghosts, Mad Scientists, Pumpkins, Skeletons, Vampires, Werewolves,
            and Witches are ready to cause trouble. Everyone gets a randomized
            deck of monsters and the tricks they can pull.
          </p>
        </li>
        <li class="step">
          <h3><span class="step__num">2.</span> Trick or treat</h3>
          <p>
            Send a monster to treat and grab candy from the bowl, or to trick
            and mess with your opponents, including eating their candy. Either
            way, the monster gets tired out: rotate the card 90 degrees
            counter-clockwise.
          </p>
        </li>
        <li class="step">
          <h3><span class="step__num">3.</span> Eat your way to victory</h3>
          <p>
            Everyone starts with 10 candy. Collect 31 to win, or be the last
            player standing. Run out of candy and you're out of the game.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band band--candy">
    <div class="container band__inner">
      <h2>Real candy. Or cardboard tokens.</h2>
      <p>
        Play with your favorite small candy, like jelly beans or Pez, and
        physically eat your opponents' points. Prefer to skip the sugar? The
        box includes cardboard candy tokens. (Don't eat the cardboard!) Candy
        is not included, so grab a bag on your way to game night.
      </p>
    </div>
  </section>

  <section class="band band--tone">
    <div class="container band__inner band__inner--split">
      <div>
        <h2>Cute until it isn't.</h2>
        <p>
          Goofy monsters with silly tricks sit right next to a genuinely creepy
          werewolf and a vampire who means business. Monster Book gives you
          both.
        </p>
      </div>
      <div class="band__art">
        {
          [sillyCard, scaryCard].map((card) =>
            card ? (
              <img
                src={card.image}
                alt={card.alt}
                width="447"
                height="595"
                loading="lazy"
                decoding="async"
              />
            ) : null
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--alt gallery-teaser">
    <div class="container">
      <h2>Meet the monsters</h2>
      <p>Seven monster types. Plenty of mischief.</p>
      <div class="gallery-teaser__art">
        <ArtPlaceholder label="TODO: monster card art 1" ratio="3 / 4" />
        <ArtPlaceholder label="TODO: monster card art 2" ratio="3 / 4" />
        <ArtPlaceholder label="TODO: monster card art 3" ratio="3 / 4" />
      </div>
      <a class="button button--secondary" href="/cards">See all cards</a>
    </div>
  </section>

  <section class="section find" id="find-monster-book">
    <div class="container">
      <h2>Find Monster Book</h2>
      <p>
        <span class="todo">TODO</span> (buy or pre-order links). Game and hobby
        shops: bundle a small pack of candy with Monster Book and give your
        customers everything they need for game night. Contact us about
        carrying the game.
        <span class="todo">TODO: retailer contact or wholesale link.</span>
      </p>
    </div>
  </section>
</Layout>

<style>
  /* Hero: purple + orange glow behind the headline */
  .hero {
    padding-block: var(--space-8) var(--space-7);
    text-align: center;
    background:
      radial-gradient(ellipse 55% 40% at 50% 22%, rgb(255 106 0 / 0.22), transparent 70%),
      radial-gradient(ellipse 90% 70% at 50% 15%, rgb(106 27 154 / 0.5), transparent 75%),
      var(--color-bg);
  }

  .hero h1 {
    color: var(--color-orange);
    text-shadow:
      0 0 18px rgb(255 106 0 / 0.55),
      0 0 48px rgb(255 106 0 / 0.3),
      0 3px 0 rgb(0 0 0 / 0.35);
  }

  .hero__subhead {
    max-width: 40rem;
    margin-inline: auto;
    font-size: var(--text-lg);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-5) 0;
    padding: 0;
    list-style: none;
  }

  .badges li {
    padding: var(--space-1) var(--space-4);
    background: rgb(106 27 154 / 0.3);
    border: 2px solid var(--color-purple);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    max-width: 22rem;
    margin-inline: auto;
  }

  .hero__art {
    max-width: 40rem;
    margin: var(--space-6) auto 0;
  }

  /* How it works: card-style steps with a large numbered badge */
  .steps {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    padding: var(--space-5);
    background: var(--color-bg);
    border: 2px solid var(--color-purple);
    border-radius: var(--radius);
  }

  .step h3 {
    color: var(--color-text);
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--space-3);
    background: var(--color-purple);
    border: 2px solid var(--color-green);
    border-radius: 50%;
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .step p {
    margin-bottom: 0;
  }

  /* Bands */
  .band {
    padding-block: var(--space-8);
  }

  .band__inner {
    max-width: 48rem;
  }

  .band p {
    font-size: var(--text-lg);
    margin-bottom: 0;
  }

  .band--candy {
    background: var(--color-bg);
    text-align: center;
  }

  /* Silly meets scary: green glow so the tone shift is obvious */
  .band--tone {
    position: relative;
    z-index: 1;
    background: linear-gradient(135deg, #0e1a14 0%, var(--color-bg) 55%, #0e1a14 100%);
    border-block: 3px solid var(--color-green);
    box-shadow:
      inset 0 0 80px rgb(126 211 33 / 0.14),
      0 0 36px rgb(126 211 33 / 0.25);
  }

  .band--tone h2 {
    text-shadow: 0 0 22px rgb(126 211 33 / 0.4);
  }

  .band__art,
  .gallery-teaser__art {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .band__art {
    margin-top: var(--space-5);
  }

  .band__art img {
    width: 100%;
    height: auto;
    border: 2px solid var(--color-purple);
    border-radius: var(--radius);
  }

  /* Gallery teaser */
  .gallery-teaser {
    text-align: center;
  }

  .gallery-teaser__art {
    grid-template-columns: repeat(3, 1fr);
    max-width: 36rem;
    margin: var(--space-5) auto var(--space-6);
  }

  /* Find Monster Book: keep the background full width, narrow the text */
  .find > .container {
    max-width: 52rem;
  }

  .find p {
    font-size: var(--text-lg);
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .step {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .step:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgb(106 27 154 / 0.5);
    }
  }

  @media (min-width: 48em) {
    .hero {
      padding-block: var(--space-9) var(--space-8);
    }

    .hero__actions {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }

    .steps {
      grid-template-columns: repeat(3, 1fr);
    }

    .band__inner--split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-7);
      max-width: var(--content-width);
    }

    .band__art {
      margin-top: 0;
    }
  }
</style>
